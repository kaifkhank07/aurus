# NODE_ENV Options { production | development } 
NODE_ENV=development

# MongoDB Credentials
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DEV_DB=development
MONGODB_PRO_DB=production

# JWT Credentials
JWT_SECRET=
JWT_EXPIRES_IN=15m
ADMIN_COOKIE_NAME=
ADMIN_COOKIE_MAX_AGE=900

# Admin Auth Credentials
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin@123

# TeleCRM Configuration
TELECRM_API_URL=https://next-api.telecrm.in/enterprise/{your_enterprise_id}/autoupdatelead
TELECRM_API_KEY=your_telecrm_api_key

# AWS S3 Configuration
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=

# Future CloudFront integration
# AWS_CLOUDFRONT_DOMAIN=
# NEXT_PUBLIC_AWS_CLOUDFRONT_DOMAIN=
