NODE_ENV=development

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DEV_DB=development
MONGODB_PRO_DB=production

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
ADMIN_COOKIE_NAME=admin_access_token
ADMIN_COOKIE_MAX_AGE=900

DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_password

# AWS S3 Configuration
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=

# Future CloudFront integration
# AWS_CLOUDFRONT_DOMAIN=
# NEXT_PUBLIC_AWS_CLOUDFRONT_DOMAIN=
